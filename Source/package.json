{
  "name": "fileup",
  "productName": "FileUp",
  "version": "3.0.1",
  "description": "FileUp — a fast, modern, cross-platform file manager for Windows & Linux. Developed by TheLxxCLoUD.",
  "homepage": "https://github.com/lxxcloud/FileUp",
  "author": "TheLxxCLoUD <lxxcloud@telegram.us>",
  "license": "MIT",
  "main": "main/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "start": "electron .",
    "build:renderer": "vite build",
    "dist:win": "npm run build:renderer && electron-builder --win --x64",
    "dist:linux": "npm run build:renderer && electron-builder --linux --x64",
    "dist": "npm run build:renderer && electron-builder --win --x64 && electron-builder --linux --x64"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "basic-ftp": "^5.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "resedit": "^2.0.0",
    "vite": "^5.4.11"
  }
}
